table DimDate
	lineageTag: 8541667b-baa7-497e-ac1e-2bd2e796a284
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: af5cdca3-bfaf-4638-a6cd-c99e5c71e6ac
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
