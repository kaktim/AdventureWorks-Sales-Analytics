table FactInternetSales
	lineageTag: 2395d38c-9637-4f4b-a6fb-0d0b1c095f54

	measure Revenue = SUMX(FactInternetSales, FactInternetSales[UnitPrice] * FactInternetSales[OrderQuantity])
		formatString: #,0.00
		displayFolder: 01 Core
		lineageTag: 3cda8742-fe51-4dac-b66f-3803df012c58

	measure 'Gross Profit' = SUMX(FactInternetSales, (FactInternetSales[UnitPrice] - FactInternetSales[UnitCost]) * FactInternetSales[OrderQuantity])
		formatString: #,0.00
		displayFolder: 01 Core
		lineageTag: 3fa02129-117b-43b3-9cbc-193712af9d01

	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Revenue])
		formatString: 0.00%
		displayFolder: 01 Core
		lineageTag: 895e686b-87b0-4e3d-8a77-f940fb0fcf4f

	measure Orders = DISTINCTCOUNT(FactInternetSales[SalesOrderNumber])
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 5b21e0d9-f3a5-423c-8c79-3257fb243561

	measure Units = SUM(FactInternetSales[OrderQuantity])
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 6019fc9a-7274-40a1-af63-f62145648053

	measure AOV = DIVIDE([Revenue], [Orders])
		formatString: #,0.00
		displayFolder: 01 Core
		lineageTag: f96351dc-f3a6-4d61-9430-3e0bd9373407

	measure 'Freight Cost' = SUM(FactInternetSales[LineFreight])
		formatString: #,0.00
		displayFolder: 01 Core
		lineageTag: 1806fafb-9edd-40bf-8049-db4de62c7494

	measure 'Freight % of Revenue' = DIVIDE([Freight Cost], [Revenue])
		formatString: 0.00%
		displayFolder: 01 Core
		lineageTag: fe35c87b-af8d-4aef-8b29-092c0975a2c2

	measure Customers = DISTINCTCOUNT(FactInternetSales[CustomerKey])
		formatString: #,0
		displayFolder: 02 Customers
		lineageTag: 946d1a28-a07c-4edf-9da5-fbbe730d7f87

	measure 'Revenue per Customer' = DIVIDE([Revenue], [Customers])
		formatString: #,0.00
		displayFolder: 02 Customers
		lineageTag: a0bc2877-fda9-4991-ae40-00e1cafdff74

	measure 'Orders per Customer' = DIVIDE([Orders], [Customers])
		formatString: 0.00
		displayFolder: 02 Customers
		lineageTag: 35ffe6db-4db5-4117-87af-d39d039b351f

	measure 'Repeat Customers' = COUNTROWS(FILTER(SUMMARIZE(FactInternetSales, FactInternetSales[CustomerKey], "OrderCount", DISTINCTCOUNT(FactInternetSales[SalesOrderNumber])), [OrderCount] >= 2))
		formatString: #,0
		displayFolder: 02 Customers
		lineageTag: 4846ecc7-96ec-4ca6-995f-65660e37ded2

	measure 'Repeat Rate' = DIVIDE([Repeat Customers], [Customers])
		formatString: 0.00%
		displayFolder: 02 Customers
		lineageTag: 1b6888b7-720b-42b7-a082-6e0d1f7c6d1e

	measure Lines = COUNTROWS(FactInternetSales)
		formatString: #,0
		displayFolder: 03 Fulfillment
		lineageTag: 9f4bb92e-6cca-4596-94ce-851bb4317a97

	measure 'Avg Lead Days' = AVERAGE(FactInternetSales[LeadDays])
		formatString: 0.00
		displayFolder: 03 Fulfillment
		lineageTag: 89ce9dba-580a-4b9d-9c7f-e5cc3220e318

	measure 'Late Lines' = CALCULATE(COUNTROWS(FactInternetSales), KEEPFILTERS(FactInternetSales[LateDays] > 0)) + 0
		formatString: #,0
		displayFolder: 03 Fulfillment
		lineageTag: b86f734f-4f77-4b3e-abf9-0ac75a910414

	measure 'Late Line Rate' = DIVIDE([Late Lines], [Lines], 0)
		formatString: 0.00%
		displayFolder: 03 Fulfillment
		lineageTag: b4479a58-f801-4c9e-bff8-9e3b9a0f138c

	measure 'Revenue PY' = CALCULATE([Revenue], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: #,0.00
		displayFolder: 04 Time intelligence
		lineageTag: ba04ceda-d9d6-4aca-a343-bb193fdddd43

	measure 'Revenue YoY %' = DIVIDE([Revenue] - [Revenue PY], [Revenue PY])
		formatString: 0.00%
		displayFolder: 04 Time intelligence
		lineageTag: c2d5b951-2868-4805-a5a0-ae98a8ac0831

	measure 'Gross Profit PY' = CALCULATE([Gross Profit], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: #,0.00
		displayFolder: 04 Time intelligence
		lineageTag: 008f32f1-5e4c-4824-bb65-668cfc251ae2

	measure 'Margin PY' = CALCULATE([Gross Margin %], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: 0.00%
		displayFolder: 04 Time intelligence
		lineageTag: 7773bb8c-db6c-4007-bbbe-2b503bdaee59

	measure 'Margin Change (pp)' = ([Gross Margin %] - [Margin PY]) * 100
		formatString: 0.00
		displayFolder: 04 Time intelligence
		lineageTag: 97dc787f-0389-4ad0-8412-a80eaeeff746

