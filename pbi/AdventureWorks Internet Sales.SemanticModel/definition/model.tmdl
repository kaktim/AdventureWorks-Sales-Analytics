model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DimCustomer","DimDate","DimGeography","DimProduct","DimSalesTerritory","FactInternetSales","Period Preset"]

ref table DimCustomer
ref table DimDate
ref table DimGeography
ref table DimProduct
ref table DimSalesTerritory
ref table FactInternetSales
ref table 'Period Preset'

ref cultureInfo en-US

